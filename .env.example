### Copy this file to `.env` and fill values. Do NOT commit your real `.env` to git.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
DV_USER=you@example.com
DV_PASS=your_password_here
LOGIN_URL=https://www.doctorville.co.kr/login
TARGET_PAGE=
HEADLESS=true
# Optional: override cron or timezone
DAILY_CRON='1 8 * * *'
SCHEDULE_TZ='Asia/Seoul'
